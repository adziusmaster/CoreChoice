<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Task 4 links the SQLite repository source; Task 5 stubs HTTP. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <!-- Task 7 onward links view models, which derive from ObservableObject. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- Task 5 links the API client, which needs IOptions<ApiOptions>. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CoreChoice.Core\CoreChoice.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\CoreChoice\Services\AppearanceChoice.cs" Link="Linked\AppearanceChoice.cs" />
    <Compile Include="..\..\src\CoreChoice\Data\LocalDbContext.cs" Link="Linked\LocalDbContext.cs" />
    <Compile Include="..\..\src\CoreChoice\Data\SqliteProfileRepository.cs" Link="Linked\SqliteProfileRepository.cs" />
    <Compile Include="..\..\src\CoreChoice\Services\ApiOptions.cs" Link="Linked\ApiOptions.cs" />
    <Compile Include="..\..\src\CoreChoice\Services\CoreChoiceApiClient.cs" Link="Linked\CoreChoiceApiClient.cs" />
    <Compile Include="..\..\src\CoreChoice\Services\VerdictLabel.cs" Link="Linked\VerdictLabel.cs" />
    <!-- Task 7: the personality test's view models. -->
    <Compile Include="..\..\src\CoreChoice\Presentation\TestIntroViewModel.cs" Link="Linked\TestIntroViewModel.cs" />
    <Compile Include="..\..\src\CoreChoice\Presentation\TestViewModel.cs" Link="Linked\TestViewModel.cs" />
    <Compile Include="..\..\src\CoreChoice\Presentation\ProfileViewModel.cs" Link="Linked\ProfileViewModel.cs" />
    <!-- Task 7c: the display band and the local note composer, both MAUI-free. -->
    <Compile Include="..\..\src\CoreChoice\Presentation\TraitDisplayBand.cs" Link="Linked\TraitDisplayBand.cs" />
    <Compile Include="..\..\src\CoreChoice\Presentation\ProfileNoteComposer.cs" Link="Linked\ProfileNoteComposer.cs" />
    <!-- Task 7d: the converters' maths, extracted so it is MAUI-free and therefore linkable —
         PresentationConverters.cs itself implements IValueConverter and uses Rect, so it cannot be. -->
    <Compile Include="..\..\src\CoreChoice\Presentation\PresentationMath.cs" Link="Linked\PresentationMath.cs" />
    <!-- Task 8: asking a question. Both view models are MAUI-free by design; IPersonaCatalog and
         PersonaSummary now live in CoreChoice.Core (CS-HEX-02) and come via the project reference. -->
    <Compile Include="..\..\src\CoreChoice\Presentation\DilemmaViewModel.cs" Link="Linked\DilemmaViewModel.cs" />
    <Compile Include="..\..\src\CoreChoice\Presentation\PersonaViewModel.cs" Link="Linked\PersonaViewModel.cs" />
    <!-- Task 8 fix round: the local, offline fallback table for the suggested persona's display
         name, MAUI-free so it can be linked and tested like PresentationMath.cs. -->
    <Compile Include="..\..\src\CoreChoice\Presentation\PersonaDisplayNames.cs" Link="Linked\PersonaDisplayNames.cs" />
    <!-- Task 9: the waiting screen and the answer itself. Both MAUI-free by design. -->
    <Compile Include="..\..\src\CoreChoice\Presentation\WaitingLineComposer.cs" Link="Linked\WaitingLineComposer.cs" />
    <Compile Include="..\..\src\CoreChoice\Presentation\AnalysisViewModel.cs" Link="Linked\AnalysisViewModel.cs" />
    <!-- Task 10: the analyses/coins screen. MAUI-free by design — PlayBillingService under
         Platforms/Android is the only part that touches a MAUI/Android type, and stays untested
         here for exactly that reason, same as this app's converters. -->
    <Compile Include="..\..\src\CoreChoice\Presentation\CoinsViewModel.cs" Link="Linked\CoinsViewModel.cs" />
    <!-- Task 11: the appearance/settings screen. IThemeStore is ThemeService's MAUI-free surface
         (ThemeService itself uses Preferences and Application.Current and cannot be linked), and
         SettingsViewModel depends on that abstraction rather than the concrete service. -->
    <Compile Include="..\..\src\CoreChoice\Services\IThemeStore.cs" Link="Linked\IThemeStore.cs" />
    <Compile Include="..\..\src\CoreChoice\Presentation\SettingsViewModel.cs" Link="Linked\SettingsViewModel.cs" />
  </ItemGroup>
</Project>
