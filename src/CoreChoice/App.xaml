<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:CoreChoice.Presentation"
             x:Class="CoreChoice.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Converters are not colours: a StaticResource here only fixes which converter
           *instance* a binding uses, it never freezes a theme colour. -->
      <presentation:LikertSelectedConverter x:Key="LikertSelectedConverter" />
      <presentation:TestPositionConverter x:Key="TestPositionConverter" />
      <presentation:TraitBandLabelConverter x:Key="TraitBandLabelConverter" />
      <presentation:TraitDotBoundsConverter x:Key="TraitDotBoundsConverter" />
      <presentation:IsNotEmptyConverter x:Key="IsNotEmptyConverter" />
      <presentation:HexColorConverter x:Key="HexColorConverter" />
      <presentation:PaletteSelectedConverter x:Key="PaletteSelectedConverter" />
      <presentation:ThemeModeSelectedConverter x:Key="ThemeModeSelectedConverter" />
      <presentation:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
