<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:CoreChoice.Presentation"
             x:Class="CoreChoice.Presentation.SettingsPage"
             x:DataType="presentation:SettingsViewModel"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <!-- Stroke is Muted, not Line: Line is a hairline meant for a surface-to-surface seam,
                 and against the page background it measures well under the 3:1 a UI component
                 needs to be perceivable at all (1.16-1.34:1 across all six palettes) — the
                 unselected button would have no visible edge. Muted is the only existing token
                 that clears 3:1 against Bg in every palette (5.47-6.53:1) without inventing a new
                 one. -->
            <Style x:Key="ModeOption" TargetType="Border">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="Stroke" Value="{DynamicResource Muted}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 9" />
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="MinimumWidthRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Fill" />
            </Style>

            <!-- The palette rows below are the same kind of selectable control as the mode
                 buttons above, so they get the same fix: CardBorder's own default Stroke (Line)
                 against its Surface fill measures 1.19-1.26:1 unselected, just as invisible.
                 PaletteOption keeps everything else CardBorder gives these rows (Surface fill,
                 corner radius) and only swaps the stroke to Muted, which measures 5.20-6.55:1
                 against Surface in all six palettes. -->
            <Style x:Key="PaletteOption" TargetType="Border" BasedOn="{StaticResource CardBorder}">
                <Setter Property="Stroke" Value="{DynamicResource Muted}" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto" Padding="24,60,24,24">

        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

                <Label Text="Appearance"
                       FontFamily="LoraMedium" FontSize="28" LineHeight="1.26" CharacterSpacing="-0.2"
                       TextColor="{DynamicResource Ink}" Margin="0,0,0,28" />

                <Label Text="MODE" Style="{StaticResource MicroLabel}" FontSize="12" Margin="0,0,0,12" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,0,0,30">

                    <!-- Each mode option is two mutually-exclusive Borders (only one IsVisible at a
                         time) rather than one Border whose colours flip via a DataTrigger. A
                         DynamicResource used as a trigger Setter value resolves once, when the
                         trigger fires, and does not re-resolve when ThemeService swaps the token
                         dictionary on a later theme change — so a row selected before a switch kept
                         the previous palette's colour. Every DynamicResource below is instead an
                         ordinary element property, which MAUI does re-resolve on a dictionary swap. -->
                    <Grid Grid.Column="0" HeightRequest="46" MinimumWidthRequest="44" HorizontalOptions="Fill">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDarkTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource ModeOption}"
                                IsVisible="{Binding SelectedMode, Converter={StaticResource ThemeModeSelectedConverter}, ConverterParameter=!Dark}">
                            <Label Text="Dark" FontFamily="DMSansMedium" FontSize="14" TextColor="{DynamicResource Muted}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource ModeOption}"
                                BackgroundColor="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                IsVisible="{Binding SelectedMode, Converter={StaticResource ThemeModeSelectedConverter}, ConverterParameter=Dark}">
                            <Label Text="Dark" FontFamily="DMSansMedium" FontSize="14" TextColor="{DynamicResource AccentInk}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Grid.Column="1" HeightRequest="46" MinimumWidthRequest="44" HorizontalOptions="Fill">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLightTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource ModeOption}"
                                IsVisible="{Binding SelectedMode, Converter={StaticResource ThemeModeSelectedConverter}, ConverterParameter=!Light}">
                            <Label Text="Light" FontFamily="DMSansMedium" FontSize="14" TextColor="{DynamicResource Muted}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource ModeOption}"
                                BackgroundColor="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                IsVisible="{Binding SelectedMode, Converter={StaticResource ThemeModeSelectedConverter}, ConverterParameter=Light}">
                            <Label Text="Light" FontFamily="DMSansMedium" FontSize="14" TextColor="{DynamicResource AccentInk}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                    <Grid Grid.Column="2" HeightRequest="46" MinimumWidthRequest="44" HorizontalOptions="Fill">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSystemTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource ModeOption}"
                                IsVisible="{Binding SelectedMode, Converter={StaticResource ThemeModeSelectedConverter}, ConverterParameter=!System}">
                            <Label Text="System" FontFamily="DMSansMedium" FontSize="14" TextColor="{DynamicResource Muted}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Border Style="{StaticResource ModeOption}"
                                BackgroundColor="{DynamicResource Accent}" Stroke="{DynamicResource Accent}"
                                IsVisible="{Binding SelectedMode, Converter={StaticResource ThemeModeSelectedConverter}, ConverterParameter=System}">
                            <Label Text="System" FontFamily="DMSansMedium" FontSize="14" TextColor="{DynamicResource AccentInk}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>

                </Grid>

                <Label Text="PALETTE" Style="{StaticResource MicroLabel}" FontSize="12" Margin="0,0,0,12" />

                <VerticalStackLayout Spacing="10">

                    <!-- Each palette row is a Grid holding two mutually-exclusive decoration
                         Borders (unselected / selected, only one IsVisible at a time) behind a
                         single content Grid, instead of one Border whose colours flip via a
                         DataTrigger — see the mode-option comment above for why the trigger form
                         goes stale across a theme switch. -->

                    <!-- Considered -->
                    <Grid MinimumHeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnConsideredTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource PaletteOption}"
                                IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=!Considered}" />
                        <Border Style="{StaticResource PaletteOption}"
                                BackgroundColor="{DynamicResource AccentWash}" Stroke="{DynamicResource AccentLine}"
                                IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=Considered}" />
                        <Grid Padding="15,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                <BoxView WidthRequest="22" HeightRequest="34" CornerRadius="5"
                                         Color="{Binding ConsideredOption.GroundHex, Converter={StaticResource HexColorConverter}}" />
                                <BoxView WidthRequest="22" HeightRequest="34" CornerRadius="5"
                                         Color="{Binding ConsideredOption.AccentHex, Converter={StaticResource HexColorConverter}}" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding ConsideredOption.Name}" FontFamily="DMSans" FontSize="15" TextColor="{DynamicResource Ink}" />
                                <Label Text="{Binding ConsideredOption.Description}" FontFamily="DMSans" FontSize="12.5" TextColor="{DynamicResource AccentDim}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&#10003;" FontFamily="DMSansBold" FontSize="16"
                                   TextColor="{DynamicResource Accent}" VerticalOptions="Center"
                                   IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=Considered}" />
                        </Grid>
                    </Grid>

                    <!-- Composed -->
                    <Grid MinimumHeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnComposedTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource PaletteOption}"
                                IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=!Composed}" />
                        <Border Style="{StaticResource PaletteOption}"
                                BackgroundColor="{DynamicResource AccentWash}" Stroke="{DynamicResource AccentLine}"
                                IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=Composed}" />
                        <Grid Padding="15,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                <BoxView WidthRequest="22" HeightRequest="34" CornerRadius="5"
                                         Color="{Binding ComposedOption.GroundHex, Converter={StaticResource HexColorConverter}}" />
                                <BoxView WidthRequest="22" HeightRequest="34" CornerRadius="5"
                                         Color="{Binding ComposedOption.AccentHex, Converter={StaticResource HexColorConverter}}" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding ComposedOption.Name}" FontFamily="DMSans" FontSize="15" TextColor="{DynamicResource Ink}" />
                                <Label Text="{Binding ComposedOption.Description}" FontFamily="DMSans" FontSize="12.5" TextColor="{DynamicResource Faint}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&#10003;" FontFamily="DMSansBold" FontSize="16"
                                   TextColor="{DynamicResource Accent}" VerticalOptions="Center"
                                   IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=Composed}" />
                        </Grid>
                    </Grid>

                    <!-- Still -->
                    <Grid MinimumHeightRequest="44">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStillTapped" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource PaletteOption}"
                                IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=!Still}" />
                        <Border Style="{StaticResource PaletteOption}"
                                BackgroundColor="{DynamicResource AccentWash}" Stroke="{DynamicResource AccentLine}"
                                IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=Still}" />
                        <Grid Padding="15,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <HorizontalStackLayout Grid.Column="0" Spacing="5">
                                <BoxView WidthRequest="22" HeightRequest="34" CornerRadius="5"
                                         Color="{Binding StillOption.GroundHex, Converter={StaticResource HexColorConverter}}" />
                                <BoxView WidthRequest="22" HeightRequest="34" CornerRadius="5"
                                         Color="{Binding StillOption.AccentHex, Converter={StaticResource HexColorConverter}}" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding StillOption.Name}" FontFamily="DMSans" FontSize="15" TextColor="{DynamicResource Ink}" />
                                <Label Text="{Binding StillOption.Description}" FontFamily="DMSans" FontSize="12.5" TextColor="{DynamicResource Faint}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="2" Text="&#10003;" FontFamily="DMSansBold" FontSize="16"
                                   TextColor="{DynamicResource Accent}" VerticalOptions="Center"
                                   IsVisible="{Binding SelectedPalette, Converter={StaticResource PaletteSelectedConverter}, ConverterParameter=Still}" />
                        </Grid>
                    </Grid>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Label Grid.Row="1" Text="More palettes will appear here over time. Nothing else changes when you switch — the words, the spacing and the type stay exactly as they are."
               FontFamily="DMSans" FontSize="12.5" LineHeight="1.55" TextColor="{DynamicResource Faint}"
               LineBreakMode="WordWrap" Margin="0,16,0,0" />

    </Grid>
</ContentPage>
