<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:CoreChoice.Presentation"
             x:Class="CoreChoice.Presentation.TestPage"
             x:DataType="presentation:TestViewModel"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="LikertButton" TargetType="Button">
                <Setter Property="HeightRequest" Value="46" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="BorderColor" Value="{DynamicResource Line}" />
                <Setter Property="TextColor" Value="{DynamicResource Faint}" />
                <Setter Property="FontFamily" Value="DMSans" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Padding="24,56,24,24">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,2">
            <Label Grid.Column="0"
                   Text="{Binding AnsweredCount, Converter={StaticResource TestPositionConverter}}"
                   FontFamily="DMSans" FontSize="13" TextColor="{DynamicResource Muted}"
                   MinimumHeightRequest="44" VerticalTextAlignment="Center" />
            <Label x:Name="HelpLabel" Grid.Column="1"
                   Text="?"
                   FontFamily="DMSansMedium" FontSize="13" TextColor="{DynamicResource Faint}"
                   MinimumHeightRequest="44" MinimumWidthRequest="44"
                   VerticalTextAlignment="Center" HorizontalTextAlignment="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHelpTapped" />
                </Label.GestureRecognizers>
            </Label>
            <Label x:Name="PauseLabel" Grid.Column="2"
                   Text="Pause"
                   FontFamily="DMSans" FontSize="13" TextColor="{DynamicResource Faint}"
                   MinimumHeightRequest="44" MinimumWidthRequest="44"
                   VerticalTextAlignment="Center" HorizontalTextAlignment="End">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPauseTapped" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <Grid Grid.Row="1" HeightRequest="2" Margin="0,0,0,34">
            <BoxView Color="{DynamicResource Line}" CornerRadius="1" HeightRequest="2" HorizontalOptions="Fill" />
            <Grid HeightRequest="2" HorizontalOptions="Fill">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="FillColumn" Width="0*" />
                    <ColumnDefinition x:Name="RestColumn" Width="1*" />
                </Grid.ColumnDefinitions>
                <BoxView Grid.Column="0" Color="{DynamicResource Accent}" CornerRadius="1" HeightRequest="2" />
            </Grid>
        </Grid>

        <Label Grid.Row="2" Text="How accurately does each describe you?"
               FontFamily="DMSans" FontSize="12" TextColor="{DynamicResource Faint}"
               Margin="0,0,0,24" />

        <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

                <VerticalStackLayout Spacing="26" BindableLayout.ItemsSource="{Binding CurrentPage}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="presentation:TestItem">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="{Binding Text}"
                                       FontFamily="Lora" FontSize="19" LineHeight="1.4"
                                       TextColor="{DynamicResource Ink}"
                                       LineBreakMode="WordWrap"
                                       Margin="0,0,0,14" />
                                <!-- Each column is two mutually-exclusive Buttons (only one
                                     IsVisible at a time) instead of one Button whose colours flip
                                     via a DataTrigger: a DynamicResource used as a trigger Setter
                                     value resolves once, when the trigger fires, and does not
                                     re-resolve when ThemeService swaps the token dictionary on a
                                     later theme change. Ordinary element properties (used on the
                                     "selected" Button below) are re-resolved on a dictionary swap. -->
                                <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="7">
                                    <Button Grid.Column="0" Text="1" Style="{StaticResource LikertButton}" CommandParameter="1" Clicked="OnLikertClicked"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=!1}" />
                                    <Button Grid.Column="0" Text="1" Style="{StaticResource LikertButton}" CommandParameter="1" Clicked="OnLikertClicked"
                                            BackgroundColor="{DynamicResource Accent}" BorderColor="{DynamicResource Accent}"
                                            TextColor="{DynamicResource AccentInk}" FontFamily="DMSansBold"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=1}" />

                                    <Button Grid.Column="1" Text="2" Style="{StaticResource LikertButton}" CommandParameter="2" Clicked="OnLikertClicked"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=!2}" />
                                    <Button Grid.Column="1" Text="2" Style="{StaticResource LikertButton}" CommandParameter="2" Clicked="OnLikertClicked"
                                            BackgroundColor="{DynamicResource Accent}" BorderColor="{DynamicResource Accent}"
                                            TextColor="{DynamicResource AccentInk}" FontFamily="DMSansBold"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=2}" />

                                    <Button Grid.Column="2" Text="3" Style="{StaticResource LikertButton}" CommandParameter="3" Clicked="OnLikertClicked"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=!3}" />
                                    <Button Grid.Column="2" Text="3" Style="{StaticResource LikertButton}" CommandParameter="3" Clicked="OnLikertClicked"
                                            BackgroundColor="{DynamicResource Accent}" BorderColor="{DynamicResource Accent}"
                                            TextColor="{DynamicResource AccentInk}" FontFamily="DMSansBold"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=3}" />

                                    <Button Grid.Column="3" Text="4" Style="{StaticResource LikertButton}" CommandParameter="4" Clicked="OnLikertClicked"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=!4}" />
                                    <Button Grid.Column="3" Text="4" Style="{StaticResource LikertButton}" CommandParameter="4" Clicked="OnLikertClicked"
                                            BackgroundColor="{DynamicResource Accent}" BorderColor="{DynamicResource Accent}"
                                            TextColor="{DynamicResource AccentInk}" FontFamily="DMSansBold"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=4}" />

                                    <Button Grid.Column="4" Text="5" Style="{StaticResource LikertButton}" CommandParameter="5" Clicked="OnLikertClicked"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=!5}" />
                                    <Button Grid.Column="4" Text="5" Style="{StaticResource LikertButton}" CommandParameter="5" Clicked="OnLikertClicked"
                                            BackgroundColor="{DynamicResource Accent}" BorderColor="{DynamicResource Accent}"
                                            TextColor="{DynamicResource AccentInk}" FontFamily="DMSansBold"
                                            IsVisible="{Binding Response, Converter={StaticResource LikertSelectedConverter}, ConverterParameter=5}" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
                    <Label Grid.Column="0" Text="Very inaccurate" FontFamily="DMSans" FontSize="11.5" TextColor="{DynamicResource Muted}" />
                    <Label Grid.Column="1" Text="Very accurate" FontFamily="DMSans" FontSize="11.5" TextColor="{DynamicResource Muted}" HorizontalTextAlignment="End" />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

        <Button Grid.Row="4" x:Name="AdvanceButton"
                Style="{StaticResource PrimaryButton}"
                Text="Next three"
                IsEnabled="{Binding CanAdvance}"
                Clicked="OnAdvanceClicked"
                Margin="0,12,0,0" />

    </Grid>
</ContentPage>
