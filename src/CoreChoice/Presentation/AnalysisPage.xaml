<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:CoreChoice.Presentation"
             x:Class="CoreChoice.Presentation.AnalysisPage"
             x:DataType="presentation:AnalysisViewModel"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- Artboard 6 · While it thinks -->
        <presentation:LoadingView IsVisible="{Binding IsWorking}" />

        <!-- Artboard 7 · The answer -->
        <Grid RowDefinitions="*,Auto" Padding="24,60,24,24" IsVisible="{Binding HasAnalysis}">

            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="0">

                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                        <HorizontalStackLayout Grid.Column="0" Spacing="9" VerticalOptions="Center">
                            <Ellipse WidthRequest="6" HeightRequest="6" Fill="{DynamicResource Accent}" />
                            <Label Text="{Binding PersonaDisplayName}" FontFamily="DMSans" FontSize="13"
                                   TextColor="{DynamicResource Muted}" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1" Text="{Binding Balance, StringFormat='{0} left'}"
                               FontFamily="DMSans" FontSize="12" TextColor="{DynamicResource Faint}"
                               VerticalOptions="Center" />
                    </Grid>

                    <Label Text="{Binding Analysis.Recommendation}"
                           FontFamily="LoraMedium" FontSize="27" LineHeight="1.3" CharacterSpacing="-0.2"
                           TextColor="{DynamicResource Ink}" Margin="0,0,0,16" LineBreakMode="WordWrap" />

                    <Border Padding="7,7,12,7" HorizontalOptions="Start" Margin="0,0,0,26"
                            StrokeShape="RoundRectangle 6" StrokeThickness="1"
                            BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsVerdictStrong}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource AccentWash}" />
                                <Setter Property="Stroke" Value="{DynamicResource AccentLine}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#10003;" FontFamily="DMSansBold" FontSize="12"
                                   TextColor="{DynamicResource Muted}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsVerdictStrong}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding Verdict}" FontFamily="DMSansMedium" FontSize="13"
                                   CharacterSpacing="0.01" TextColor="{DynamicResource Muted}" VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsVerdictStrong}" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource Accent}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </HorizontalStackLayout>
                    </Border>

                    <Border Style="{StaticResource AccentCardBorder}" Padding="18,18,18,20" Margin="0,0,0,22"
                            IsVisible="{Binding Analysis.IsPersonalized}">
                        <VerticalStackLayout Spacing="11">
                            <Label Text="BECAUSE IT IS YOU ASKING" Style="{StaticResource MicroLabel}"
                                   TextColor="{DynamicResource Accent}" FontSize="11" />
                            <Label Text="{Binding Analysis.PersonalityNote}"
                                   FontFamily="Lora" FontSize="16" LineHeight="1.6"
                                   TextColor="{DynamicResource InkSoft}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Border>

                    <VerticalStackLayout Spacing="15" BindableLayout.ItemsSource="{Binding Analysis.Reasoning}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Grid ColumnDefinitions="20,13,*">
                                    <Ellipse Grid.Column="0" WidthRequest="6" HeightRequest="6"
                                             Fill="{DynamicResource Accent}" VerticalOptions="Start" Margin="0,7,0,0" />
                                    <Label Grid.Column="2" Text="{Binding .}"
                                           FontFamily="DMSans" FontSize="14" LineHeight="1.55"
                                           TextColor="{DynamicResource Muted}" LineBreakMode="WordWrap" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="14" Margin="0,22,0,0" IsVisible="{Binding AreBothSidesShown}">
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Option A — strengths and risks" Style="{StaticResource MicroLabel}"
                                       TextColor="{DynamicResource Faint}" FontSize="11" />
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Analysis.OptionA.Strengths}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding ., StringFormat='+ {0}'}" FontFamily="DMSans" FontSize="13.5"
                                                   TextColor="{DynamicResource InkSoft}" LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Analysis.OptionA.Risks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding ., StringFormat='− {0}'}" FontFamily="DMSans" FontSize="13.5"
                                                   TextColor="{DynamicResource Faint}" LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Padding="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Option B — strengths and risks" Style="{StaticResource MicroLabel}"
                                       TextColor="{DynamicResource Faint}" FontSize="11" />
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Analysis.OptionB.Strengths}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding ., StringFormat='+ {0}'}" FontFamily="DMSans" FontSize="13.5"
                                                   TextColor="{DynamicResource InkSoft}" LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                                <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Analysis.OptionB.Risks}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Label Text="{Binding ., StringFormat='− {0}'}" FontFamily="DMSans" FontSize="13.5"
                                                   TextColor="{DynamicResource Faint}" LineBreakMode="WordWrap" />
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <VerticalStackLayout Grid.Row="1" Spacing="16" Margin="0,12,0,0">
                <Label Text="You can sit with this. It will be here in the morning."
                       FontFamily="Lora" FontAttributes="Italic" FontSize="14" LineHeight="1.55"
                       TextColor="{DynamicResource Faint}" LineBreakMode="WordWrap" />
                <Grid ColumnDefinitions="*,1.2*" ColumnSpacing="10">
                    <Button Grid.Column="0" Text="Both sides" Style="{StaticResource SecondaryButton}"
                            Clicked="OnBothSidesClicked" />
                    <Button Grid.Column="1" Text="That settles it" Style="{StaticResource PrimaryButton}"
                            Clicked="OnSettledClicked" />
                </Grid>
            </VerticalStackLayout>

        </Grid>

        <!-- Error state: no artboard covers this — see AnalysisPage.xaml.cs doc comment. -->
        <Grid RowDefinitions="*,Auto" Padding="24,60,24,24" IsVisible="{Binding HasError}">
            <VerticalStackLayout Grid.Row="0" Spacing="16" VerticalOptions="Center">
                <Label Text="{Binding ErrorMessage}"
                       FontFamily="Lora" FontSize="20" LineHeight="1.4"
                       TextColor="{DynamicResource Ink}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Row="1" Spacing="10">
                <Button Text="Try again" Style="{StaticResource PrimaryButton}"
                        IsVisible="{Binding CanRetry}" Clicked="OnRetryClicked" />
                <Button Text="Get more coins" Style="{StaticResource PrimaryButton}"
                        IsVisible="{Binding IsOutOfCoins}" Clicked="OnGetCoinsClicked" />
                <Button Text="Change the question" Style="{StaticResource SecondaryButton}"
                        Clicked="OnChangeQuestionClicked" />
            </VerticalStackLayout>
        </Grid>

    </Grid>
</ContentPage>
