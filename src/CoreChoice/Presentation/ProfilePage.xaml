<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:presentation="clr-namespace:CoreChoice.Presentation"
             x:Class="CoreChoice.Presentation.ProfilePage"
             x:DataType="presentation:ProfileViewModel"
             Style="{StaticResource PageStyle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto" Padding="24,52,24,24">

        <ScrollView Grid.Row="0" VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="0">

                <Label Text="This is how you tend to decide."
                       FontFamily="LoraMedium" FontSize="28" LineHeight="1.28" CharacterSpacing="-0.2"
                       TextColor="{DynamicResource Ink}" Margin="0,0,0,20" />

                <VerticalStackLayout Spacing="16" Margin="0,0,0,20">

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Openness" FontFamily="DMSans" FontSize="14" TextColor="{DynamicResource Ink}" />
                            <Label Grid.Column="1" Text="{Binding Profile.Openness, Converter={StaticResource TraitBandLabelConverter}}" FontFamily="DMSans" FontSize="13" TextColor="{DynamicResource Muted}" />
                        </Grid>
                        <Grid HeightRequest="14">
                            <BoxView Color="{DynamicResource Line}" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">
                                <BoxView AbsoluteLayout.LayoutFlags="PositionProportional"
                                         AbsoluteLayout.LayoutBounds="{Binding Profile.Openness, Converter={StaticResource TraitDotBoundsConverter}}"
                                         WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                         Color="{DynamicResource Accent}" />
                            </AbsoluteLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Conscientiousness" FontFamily="DMSans" FontSize="14" TextColor="{DynamicResource Ink}" />
                            <Label Grid.Column="1" Text="{Binding Profile.Conscientiousness, Converter={StaticResource TraitBandLabelConverter}}" FontFamily="DMSans" FontSize="13" TextColor="{DynamicResource Muted}" />
                        </Grid>
                        <Grid HeightRequest="14">
                            <BoxView Color="{DynamicResource Line}" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">
                                <BoxView AbsoluteLayout.LayoutFlags="PositionProportional"
                                         AbsoluteLayout.LayoutBounds="{Binding Profile.Conscientiousness, Converter={StaticResource TraitDotBoundsConverter}}"
                                         WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                         Color="{DynamicResource Accent}" />
                            </AbsoluteLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Extraversion" FontFamily="DMSans" FontSize="14" TextColor="{DynamicResource Ink}" />
                            <Label Grid.Column="1" Text="{Binding Profile.Extraversion, Converter={StaticResource TraitBandLabelConverter}}" FontFamily="DMSans" FontSize="13" TextColor="{DynamicResource Muted}" />
                        </Grid>
                        <Grid HeightRequest="14">
                            <BoxView Color="{DynamicResource Line}" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">
                                <BoxView AbsoluteLayout.LayoutFlags="PositionProportional"
                                         AbsoluteLayout.LayoutBounds="{Binding Profile.Extraversion, Converter={StaticResource TraitDotBoundsConverter}}"
                                         WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                         Color="{DynamicResource Accent}" />
                            </AbsoluteLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Agreeableness" FontFamily="DMSans" FontSize="14" TextColor="{DynamicResource Ink}" />
                            <Label Grid.Column="1" Text="{Binding Profile.Agreeableness, Converter={StaticResource TraitBandLabelConverter}}" FontFamily="DMSans" FontSize="13" TextColor="{DynamicResource Muted}" />
                        </Grid>
                        <Grid HeightRequest="14">
                            <BoxView Color="{DynamicResource Line}" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">
                                <BoxView AbsoluteLayout.LayoutFlags="PositionProportional"
                                         AbsoluteLayout.LayoutBounds="{Binding Profile.Agreeableness, Converter={StaticResource TraitDotBoundsConverter}}"
                                         WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                         Color="{DynamicResource Accent}" />
                            </AbsoluteLayout>
                        </Grid>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0" Text="Neuroticism" FontFamily="DMSans" FontSize="14" TextColor="{DynamicResource Ink}" />
                            <Label Grid.Column="1" Text="{Binding Profile.Neuroticism, Converter={StaticResource TraitBandLabelConverter}}" FontFamily="DMSans" FontSize="13" TextColor="{DynamicResource Muted}" />
                        </Grid>
                        <Grid HeightRequest="14">
                            <BoxView Color="{DynamicResource Line}" HeightRequest="1" VerticalOptions="Center" HorizontalOptions="Fill" />
                            <AbsoluteLayout HorizontalOptions="Fill" VerticalOptions="Fill">
                                <BoxView AbsoluteLayout.LayoutFlags="PositionProportional"
                                         AbsoluteLayout.LayoutBounds="{Binding Profile.Neuroticism, Converter={StaticResource TraitDotBoundsConverter}}"
                                         WidthRequest="10" HeightRequest="10" CornerRadius="5"
                                         Color="{DynamicResource Accent}" />
                            </AbsoluteLayout>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,20">
                    <Label Text="{Binding Note}"
                           FontFamily="Lora" FontSize="16" LineHeight="1.58"
                           TextColor="{DynamicResource InkSoft}" LineBreakMode="WordWrap" />
                </Border>

                <!-- Two groups, not one list with badges. Which trait lands in which group
                     depends on the score, so both are data-driven and either can be empty: a
                     profile that is moderate on everything has no established passages at all,
                     and the heading disappears with them rather than standing over nothing. -->
                <VerticalStackLayout Spacing="10" Margin="0,0,0,18" IsVisible="{Binding HasEvidencePassages}">

                    <Label Text="WHAT RESEARCH SUPPORTS" Style="{StaticResource MicroLabel}"
                           TextColor="{DynamicResource Accent}" />
                    <Label Text="From large studies, at the strength those studies actually found."
                           FontFamily="DMSans" FontSize="13" LineHeight="1.5"
                           TextColor="{DynamicResource Muted}" Margin="0,0,0,2" LineBreakMode="WordWrap" />

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding EvidencePassages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="presentation:TraitPassage">
                                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding TraitName}" FontFamily="DMSansMedium" FontSize="13" TextColor="{DynamicResource Ink}" />
                                        <Label Text="{Binding Text}"
                                               FontFamily="Lora" FontSize="15" LineHeight="1.55"
                                               TextColor="{DynamicResource InkSoft}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" Margin="0,0,0,14" IsVisible="{Binding HasInterpretedPassages}">

                    <Label Text="ONE WAY TO READ THE REST" Style="{StaticResource MicroLabel}" />
                    <Label Text="Nothing below is established. It is one reading of the score, or a fact about people in general — not something measured about you."
                           FontFamily="DMSans" FontSize="13" LineHeight="1.5"
                           TextColor="{DynamicResource Muted}" Margin="0,0,0,2" LineBreakMode="WordWrap" />

                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding InterpretedPassages}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="presentation:TraitPassage">
                                <Border Style="{StaticResource CardBorder}" Padding="16,14">
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding TraitName}" FontFamily="DMSansMedium" FontSize="13" TextColor="{DynamicResource Muted}" />
                                        <Label Text="{Binding Text}"
                                               FontFamily="Lora" FontSize="15" LineHeight="1.55"
                                               TextColor="{DynamicResource Muted}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>

                <Border Style="{StaticResource AccentCardBorder}" Padding="14,14,16,14" Margin="0,0,0,14"
                        IsVisible="{Binding GrantMessage, Converter={StaticResource IsNotEmptyConverter}}">
                    <Grid ColumnDefinitions="18,11,*">
                        <Label Grid.Column="0" Text="&#10003;" FontFamily="DMSansBold" FontSize="13"
                               TextColor="{DynamicResource Accent}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="{Binding GrantMessage}"
                               FontFamily="DMSans" FontSize="14" LineHeight="1.5"
                               TextColor="{DynamicResource Ink}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Spacing="0" Margin="0,12,0,0">
            <Label FontFamily="DMSans" FontSize="12.5" LineHeight="1.55"
                   TextColor="{DynamicResource Faint}" Margin="0,0,0,16">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Kept on this phone. " />
                        <Span Text="Retake it whenever you like."
                              FontFamily="DMSansMedium" TextColor="{DynamicResource Muted}">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRetakeClicked" />
                            </Span.GestureRecognizers>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Button Text="Ask it something" Style="{StaticResource PrimaryButton}" Clicked="OnAskClicked" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
