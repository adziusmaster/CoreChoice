<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="CoreChoice.AppShell"
       FlyoutBehavior="Disabled"
       Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="{DynamicResource Surface}"
       Shell.TabBarTitleColor="{DynamicResource Accent}"
       Shell.TabBarForegroundColor="{DynamicResource Accent}"
       Shell.TabBarUnselectedColor="{DynamicResource Faint}"
       Shell.TabBarDisabledColor="{DynamicResource Line}" />
