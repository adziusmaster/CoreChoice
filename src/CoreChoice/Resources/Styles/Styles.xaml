<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--
      Every colour below is a DynamicResource, never a literal and never a StaticResource.
      StaticResource binds once and will not follow a theme switch — the element simply
      keeps the old colour, which is the silent failure the token system exists to prevent.
    -->

    <Style x:Key="PageStyle" TargetType="Page">
        <Setter Property="BackgroundColor" Value="{DynamicResource Bg}" />
    </Style>

    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="LoraMedium" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{DynamicResource Ink}" />
    </Style>

    <Style x:Key="BodyLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="DMSans" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
    </Style>

    <Style x:Key="AdviceLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="Lora" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.6" />
        <Setter Property="TextColor" Value="{DynamicResource InkSoft}" />
    </Style>

    <Style x:Key="MicroLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="DMSansMedium" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.2" />
        <Setter Property="TextColor" Value="{DynamicResource Faint}" />
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="TextColor" Value="{DynamicResource AccentInk}" />
        <Setter Property="FontFamily" Value="DMSansMedium" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderWidth" Value="0" />
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
        <Setter Property="FontFamily" Value="DMSansMedium" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource Line}" />
    </Style>

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface}" />
        <Setter Property="Stroke" Value="{DynamicResource Line}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

    <Style x:Key="AccentCardBorder" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentWash}" />
        <Setter Property="Stroke" Value="{DynamicResource AccentLine}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 10" />
    </Style>

</ResourceDictionary>
